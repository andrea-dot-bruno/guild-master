<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<!-- Controller supplied by FXMLLoader.setController(...). No demonstration game data. -->
<DialogPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@guild-theme.css" fx:id="weaponSelectionDialogPane" prefWidth="730" prefHeight="465" minHeight="0" styleClass="guild-dialog">
  <header>
    <HBox spacing="12" alignment="CENTER_LEFT">
      <ImageView fitWidth="35" fitHeight="43" preserveRatio="true" smooth="false">
        <image>
          <Image url="@assets/crest.png"/>
        </image>
      </ImageView>
      <Label text="Change weapon" styleClass="dialog-title"/>
    </HBox>
  </header>
  <content>
    <VBox spacing="10">
      <Label text="—" styleClass="muted" fx:id="weaponTargetHeroLabel"/>
      <HBox spacing="16" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
        <VBox spacing="12" prefWidth="310" HBox.hgrow="ALWAYS">
          <ListView fx:id="compatibleWeaponsList" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-list">
            <placeholder>
              <Label text="No compatible weapons available." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
            </placeholder>
          </ListView>
        </VBox>
        <VBox spacing="8" prefWidth="265" minWidth="250" styleClass="panel" minHeight="0">
          <ImageView fitWidth="75" fitHeight="85" preserveRatio="true" smooth="false" fx:id="weaponPreviewImageView"/>
          <Label text="—" styleClass="detail-title" fx:id="weaponNameLabel"/>
          <Label text="—" styleClass="muted" fx:id="weaponTypeLabel"/>
          <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
            <Label text="Current power" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS" minWidth="0"/>
            <Label text="—" styleClass="value" fx:id="currentWeaponPowerLabel"/>
          </HBox>
          <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
            <Label text="New power" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS" minWidth="0"/>
            <Label text="—" styleClass="value" fx:id="newWeaponPowerLabel"/>
          </HBox>
          <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
            <Label text="Difference" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS" minWidth="0"/>
            <Label text="—" styleClass="value" fx:id="weaponPowerDifferenceLabel"/>
          </HBox>
        </VBox>
      </HBox>
      <Label text="The replaced weapon will return to the inventory." styleClass="small" wrapText="true"/>
      <Label fx:id="equipmentFeedbackLabel" text="" styleClass="feedback" wrapText="true" visible="false" managed="false"/>
    </VBox>
  </content>
  <buttonTypes>
    <ButtonType fx:id="cancelEquipButtonType" text="Cancel" buttonData="CANCEL_CLOSE"/>
    <ButtonType fx:id="confirmEquipButtonType" text="Equip" buttonData="OK_DONE"/>
  </buttonTypes>
</DialogPane>
