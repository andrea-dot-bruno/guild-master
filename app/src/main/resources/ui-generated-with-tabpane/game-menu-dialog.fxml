<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<!-- Controller supplied by FXMLLoader.setController(...). No demonstration game data. -->
<DialogPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@guild-theme.css" fx:id="gameMenuDialogPane" prefWidth="440" prefHeight="390" minHeight="0" styleClass="guild-dialog">
  <header>
    <HBox spacing="12" alignment="CENTER_LEFT">
      <ImageView fitWidth="35" fitHeight="43" preserveRatio="true" smooth="false">
        <image>
          <Image url="@assets/crest.png"/>
        </image>
      </ImageView>
      <Label text="Game menu" styleClass="dialog-title"/>
    </HBox>
  </header>
  <content>
    <VBox spacing="12">
      <Button fx:id="saveGameButton" text="Save game" mnemonicParsing="false" styleClass="primary" disable="false" maxWidth="Infinity"/>
      <Button fx:id="loadGameButton" text="Load game" mnemonicParsing="false" styleClass="secondary" disable="false" maxWidth="Infinity"/>
      <Button fx:id="returnToMainMenuButton" text="Main menu" mnemonicParsing="false" styleClass="secondary" disable="false" maxWidth="Infinity"/>
      <Separator/>
      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
        <Label text="Last save" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
        <Label text="—" styleClass="value" fx:id="lastSaveSummaryLabel"/>
      </HBox>
      <Label fx:id="saveFeedbackLabel" text="" styleClass="feedback" wrapText="true" visible="false" managed="false"/>
    </VBox>
  </content>
  <buttonTypes>
    <ButtonType fx:id="resumeButtonType" text="Resume" buttonData="CANCEL_CLOSE"/>
  </buttonTypes>
</DialogPane>
