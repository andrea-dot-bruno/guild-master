<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<!-- Controller supplied by FXMLLoader.setController(...). No demonstration game data. -->
<DialogPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@guild-theme.css" fx:id="endDayDialogPane" prefWidth="600" prefHeight="400" minHeight="0" styleClass="guild-dialog">
  <header>
    <HBox spacing="12" alignment="CENTER_LEFT">
      <ImageView fitWidth="35" fitHeight="43" preserveRatio="true" smooth="false">
        <image>
          <Image url="@assets/crest.png"/>
        </image>
      </ImageView>
      <Label text="End day?" styleClass="dialog-title"/>
    </HBox>
  </header>
  <content>
    <VBox spacing="10">
      <Label fx:id="endDayMessageLabel" text="Advance to the next day and refresh the available opportunities." wrapText="true" styleClass="muted"/>
      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
        <Label text="Current day" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
        <Label text="—" styleClass="value" fx:id="currentDayLabel"/>
      </HBox>
      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
        <Label text="Next day" styleClass="muted"/>
        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
        <Label text="—" styleClass="value" fx:id="nextDayLabel"/>
      </HBox>
      <ListView fx:id="returningExpeditionsList" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-list">
        <placeholder>
          <Label text="No expeditions returning on the next day." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
        </placeholder>
      </ListView>
      <Label text="The shop and boards refresh with the new day." styleClass="small" wrapText="true"/>
    </VBox>
  </content>
  <buttonTypes>
    <ButtonType fx:id="keepPlanningButtonType" text="Keep planning" buttonData="CANCEL_CLOSE"/>
    <ButtonType fx:id="confirmEndDayButtonType" text="End day" buttonData="OK_DONE"/>
  </buttonTypes>
</DialogPane>
