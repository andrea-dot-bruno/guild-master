<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<!-- Controller supplied by FXMLLoader.setController(...). No demonstration game data. -->
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@guild-theme.css" fx:id="guildRoot" prefWidth="1120" prefHeight="700" minWidth="1000" minHeight="680" styleClass="guild-root">
  <fx:define>
    <ToggleGroup fx:id="shopModeToggleGroup"/>
  </fx:define>
  <top>
    <HBox spacing="12" styleClass="app-header" alignment="CENTER_LEFT">
      <ImageView fitWidth="46" fitHeight="55" preserveRatio="true" smooth="false">
        <image>
          <Image url="@assets/crest.png"/>
        </image>
      </ImageView>
      <Label text="GUILD MASTER" styleClass="brand"/>
      <Label text="│" styleClass="muted"/>
      <Label text="—" styleClass="guild-name" fx:id="guildNameLabel"/>
      <Region HBox.hgrow="ALWAYS" minWidth="0"/>
      <Label text="Day" styleClass="small"/>
      <Label text="—" styleClass="header-stat" fx:id="dayLabel"/>
      <ImageView fitWidth="25" fitHeight="25" preserveRatio="true" smooth="false">
        <image>
          <Image url="@assets/coin.png"/>
        </image>
      </ImageView>
      <Label text="—" styleClass="header-stat" fx:id="goldLabel"/>
      <Button fx:id="openMenuButton" text="Menu" mnemonicParsing="false" styleClass="secondary" disable="false" maxWidth="Infinity"/>
    </HBox>
  </top>
  <center>
    <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs" VBox.vgrow="ALWAYS" minHeight="0">
      <tabs>
        <Tab fx:id="overviewTab" text="Overview" closable="false" disable="false">
          <content>
            <VBox spacing="12" styleClass="panel" minWidth="0" minHeight="0">
              <HBox spacing="12" styleClass="heading" alignment="CENTER_LEFT">
                <ImageView fitWidth="86" fitHeight="70" preserveRatio="true" smooth="false">
                  <image>
                    <Image url="@assets/guild-house.png"/>
                  </image>
                </ImageView>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                  <Label text="A new day at the guild" styleClass="page-title"/>
                  <Label text="Prepare your heroes, then choose your next expedition." styleClass="muted" wrapText="true"/>
                </VBox>
                <Button fx:id="planExpeditionButton" text="Plan expedition" mnemonicParsing="false" styleClass="primary" disable="false" maxWidth="Infinity"/>
              </HBox>
              <HBox spacing="12" VBox.vgrow="ALWAYS" minHeight="0" alignment="CENTER_LEFT">
                <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="745" minWidth="0">
                  <Label text="ACTIVE EXPEDITIONS" styleClass="section-title"/>
                  <TableView fx:id="overviewExpeditionsTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                    <columns>
                      <TableColumn fx:id="overviewExpeditionNameColumn" text="Expedition" prefWidth="210" minWidth="45"/>
                      <TableColumn fx:id="overviewPartyColumn" text="Heroes" prefWidth="180" minWidth="45"/>
                      <TableColumn fx:id="overviewRemainingColumn" text="Remaining" prefWidth="125" minWidth="45"/>
                      <TableColumn fx:id="overviewProgressColumn" text="Progress" prefWidth="115" minWidth="45"/>
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                      <Label text="No expeditions underway.&#10;Choose a contract from the Expeditions tab." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                    </placeholder>
                  </TableView>
                </VBox>
                <VBox spacing="10" prefWidth="255" minWidth="230">
                  <Label text="AVAILABLE HEROES" styleClass="section-title"/>
                  <ListView fx:id="availableHeroesList" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-list">
                    <placeholder>
                      <Label text="No available heroes." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                    </placeholder>
                  </ListView>
                  <Button fx:id="viewHeroesButton" text="View heroes" mnemonicParsing="false" styleClass="secondary" disable="false" maxWidth="Infinity"/>
                </VBox>
              </HBox>
              <Label text="—" styleClass="muted" fx:id="overviewSummaryLabel"/>
            </VBox>
          </content>
        </Tab>
        <Tab fx:id="expeditionsTab" text="Expeditions" closable="false" disable="false">
          <content>
            <VBox spacing="8" styleClass="panel" minWidth="0" minHeight="0">
              <HBox spacing="12" styleClass="heading" alignment="CENTER_LEFT">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                  <Label text="Expedition board" styleClass="page-title"/>
                </VBox>
              </HBox>
              <TabPane fx:id="expeditionsTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="sub-tabs" VBox.vgrow="ALWAYS" minHeight="0">
                <tabs>
                  <Tab fx:id="availableExpeditionsTab" text="Available" closable="false" disable="false">
                    <content>
                      <SplitPane dividerPositions="0.46" VBox.vgrow="ALWAYS" minHeight="0" styleClass="content-split">
                        <items>
                          <VBox spacing="12" styleClass="panel" minWidth="0" minHeight="0">
                            <Label text="AVAILABLE CONTRACTS" styleClass="section-title"/>
                            <TableView fx:id="contractsTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                              <columns>
                                <TableColumn fx:id="contractNameColumn" text="Dungeon" prefWidth="205" minWidth="45"/>
                                <TableColumn fx:id="contractDurationColumn" text="Days" prefWidth="70" minWidth="45"/>
                                <TableColumn fx:id="contractRewardColumn" text="Reward" prefWidth="95" minWidth="45"/>
                              </columns>
                              <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                              </columnResizePolicy>
                              <placeholder>
                                <Label text="No contracts available." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                              </placeholder>
                            </TableView>
                          </VBox>
                          <BorderPane minWidth="0">
                            <center>
                              <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0" styleClass="content-scroll" fx:id="contractDetailScroll">
                                <content>
                                  <VBox spacing="8" styleClass="panel" minWidth="0" minHeight="0">
                                    <Label text="—" styleClass="detail-title" fx:id="dungeonNameLabel"/>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                      <ImageView fitWidth="180" fitHeight="95" preserveRatio="true" smooth="false" fx:id="dungeonImageView"/>
                                      <Label fx:id="dungeonDescriptionLabel" text="Select a contract to see its details." wrapText="true" styleClass="muted" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                      <Label text="Difficulty" styleClass="muted"/>
                                      <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                      <Label text="—" styleClass="value" fx:id="dungeonDifficultyLabel"/>
                                    </HBox>
                                    <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                      <Label text="Duration" styleClass="muted"/>
                                      <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                      <Label text="—" styleClass="value" fx:id="dungeonDurationLabel"/>
                                    </HBox>
                                    <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                      <Label text="Reward" styleClass="muted"/>
                                      <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                      <Label text="—" styleClass="value" fx:id="dungeonRewardLabel"/>
                                    </HBox>
                                    <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                      <Label text="Party requirements" styleClass="muted"/>
                                      <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                      <Label text="—" styleClass="value" fx:id="dungeonRequirementsLabel"/>
                                    </HBox>
                                    <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                      <Label text="Possible find" styleClass="muted"/>
                                      <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                      <Label text="—" styleClass="value" fx:id="dungeonPossibleLootLabel"/>
                                    </HBox>
                                  </VBox>
                                </content>
                              </ScrollPane>
                            </center>
                            <bottom>
                              <VBox spacing="0" styleClass="panel" minWidth="0" minHeight="0">
                                <Button fx:id="preparePartyButton" text="Prepare party" mnemonicParsing="false" styleClass="primary" disable="true" maxWidth="Infinity"/>
                              </VBox>
                            </bottom>
                          </BorderPane>
                        </items>
                      </SplitPane>
                    </content>
                  </Tab>
                  <Tab fx:id="underwayExpeditionsTab" text="Underway" closable="false" disable="false">
                    <content>
                      <VBox spacing="12" styleClass="panel" minWidth="0" minHeight="0">
                        <Label text="EXPEDITIONS UNDERWAY" styleClass="section-title"/>
                        <TableView fx:id="underwayExpeditionsTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                          <columns>
                            <TableColumn fx:id="underwayNameColumn" text="Expedition" prefWidth="240" minWidth="45"/>
                            <TableColumn fx:id="underwayPartyColumn" text="Heroes" prefWidth="260" minWidth="45"/>
                            <TableColumn fx:id="underwayDaysColumn" text="Days remaining" prefWidth="130" minWidth="45"/>
                            <TableColumn fx:id="underwayProgressColumn" text="Progress" prefWidth="150" minWidth="45"/>
                            <TableColumn fx:id="underwayRewardColumn" text="Reward" prefWidth="130" minWidth="45"/>
                          </columns>
                          <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                          </columnResizePolicy>
                          <placeholder>
                            <Label text="No expeditions underway." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                          </placeholder>
                        </TableView>
                        <Label text="Heroes, weapons and supplies remain committed until the expedition ends." styleClass="small" wrapText="true"/>
                      </VBox>
                    </content>
                  </Tab>
                  <Tab fx:id="preparePartyTab" text="Prepare party" closable="false" disable="true">
                    <content>
                      <HBox spacing="0" styleClass="preparation-columns" minHeight="0" alignment="CENTER_LEFT">
                        <VBox spacing="12" prefWidth="340" HBox.hgrow="ALWAYS" styleClass="panel" minWidth="0" minHeight="0">
                          <Label text="CHOOSE HEROES" styleClass="section-title"/>
                          <Label text="Select one or more available heroes." styleClass="small" wrapText="true"/>
                          <TableView fx:id="partyHeroesTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                            <columns>
                              <TableColumn fx:id="partyHeroNameColumn" text="Hero" prefWidth="130" minWidth="45"/>
                              <TableColumn fx:id="partyHeroClassColumn" text="Class" prefWidth="95" minWidth="45"/>
                              <TableColumn fx:id="partyHeroWageColumn" text="Wage" prefWidth="75" minWidth="45"/>
                            </columns>
                            <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                            </columnResizePolicy>
                            <placeholder>
                              <Label text="No available heroes." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                            </placeholder>
                          </TableView>
                          <Label text="Heroes on expeditions cannot join another party." styleClass="small" wrapText="true"/>
                        </VBox>
                        <VBox spacing="6" prefWidth="355" HBox.hgrow="ALWAYS" styleClass="panel" minWidth="0" minHeight="0">
                          <Label text="PARTY" styleClass="section-title"/>
                          <ListView fx:id="selectedPartyList" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-list">
                            <placeholder>
                              <Label text="No heroes selected." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                            </placeholder>
                          </ListView>
                          <Label text="EXPEDITION SUPPLIES" styleClass="section-title"/>
                          <TableView fx:id="partySuppliesTable" VBox.vgrow="ALWAYS" minHeight="100" prefHeight="145" styleClass="data-table">
                            <columns>
                              <TableColumn fx:id="partySupplyNameColumn" text="Supply" prefWidth="155" minWidth="45"/>
                              <TableColumn fx:id="partySupplyStockColumn" text="Stock" prefWidth="65" minWidth="45"/>
                              <TableColumn fx:id="partySupplyQuantityColumn" text="Assigned" prefWidth="75" minWidth="45"/>
                            </columns>
                            <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                            </columnResizePolicy>
                            <placeholder>
                              <Label text="No supplies available." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                            </placeholder>
                          </TableView>
                          <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Assigned quantity" styleClass="small"/>
                            <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                            <Spinner fx:id="partySupplyQuantitySpinner" editable="false" disable="true" prefWidth="90"/>
                          </HBox>
                          <Label text="Supplies belong to the party. Weapons stay equipped." styleClass="small" wrapText="true" minHeight="34" prefHeight="34"/>
                        </VBox>
                        <BorderPane prefWidth="340" minWidth="0" HBox.hgrow="ALWAYS" styleClass="preparation-summary">
                          <center>
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0" styleClass="content-scroll" fx:id="partySummaryScroll">
                              <content>
                                <VBox spacing="5" styleClass="summary-content" minHeight="0">
                                  <Label text="EXPEDITION SUMMARY" styleClass="section-title"/>
                                  <Label text="—" styleClass="item-title" fx:id="preparedDungeonNameLabel"/>
                                  <HBox spacing="12" alignment="CENTER_LEFT">
                                    <Label text="Success chance" styleClass="muted"/>
                                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                    <Label text="—" styleClass="item-title" fx:id="partySuccessChanceLabel"/>
                                  </HBox>
                                  <ProgressBar fx:id="partySuccessChanceProgressBar" progress="0" minHeight="14" prefHeight="14" maxHeight="14" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                  <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                    <Label text="Heroes" styleClass="muted"/>
                                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                    <Label text="—" styleClass="value" fx:id="partySizeLabel"/>
                                  </HBox>
                                  <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                    <Label text="Wages" styleClass="muted"/>
                                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                    <Label text="—" styleClass="value" fx:id="partyWagesLabel"/>
                                  </HBox>
                                  <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                    <Label text="Gold after departure" styleClass="muted"/>
                                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                    <Label text="—" styleClass="value" fx:id="partyGoldAfterDepartureLabel"/>
                                  </HBox>
                                  <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                    <Label text="Duration" styleClass="muted"/>
                                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                    <Label text="—" styleClass="value" fx:id="partyDurationLabel"/>
                                  </HBox>
                                  <Label text="Wages are paid when the party departs." styleClass="small" wrapText="true"/>
                                  <Label fx:id="partyValidationLabel" text="" styleClass="feedback" wrapText="true" visible="false" managed="false"/>
                                </VBox>
                              </content>
                            </ScrollPane>
                          </center>
                          <bottom>
                            <HBox spacing="8" styleClass="summary-actions" alignment="CENTER_LEFT">
                              <Button fx:id="cancelPreparationButton" text="Cancel" mnemonicParsing="false" styleClass="secondary" disable="false" maxWidth="Infinity"/>
                              <Button fx:id="launchExpeditionButton" text="Launch expedition" mnemonicParsing="false" styleClass="primary" disable="true" maxWidth="Infinity"/>
                            </HBox>
                          </bottom>
                        </BorderPane>
                      </HBox>
                    </content>
                  </Tab>
                </tabs>
              </TabPane>
            </VBox>
          </content>
        </Tab>
        <Tab fx:id="heroesTab" text="Heroes" closable="false" disable="false">
          <content>
            <SplitPane dividerPositions="0.39" VBox.vgrow="ALWAYS" minHeight="0" styleClass="content-split">
              <items>
                <VBox spacing="12" styleClass="panel" minWidth="0" minHeight="0">
                  <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="GUILD HEROES" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                    <ComboBox fx:id="heroFilterComboBox" promptText="All heroes" prefWidth="150" minWidth="130"/>
                  </HBox>
                  <TableView fx:id="heroesTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                    <columns>
                      <TableColumn fx:id="heroNameColumn" text="Name" prefWidth="130" minWidth="45"/>
                      <TableColumn fx:id="heroClassColumn" text="Class" prefWidth="90" minWidth="45"/>
                      <TableColumn fx:id="heroLevelColumn" text="Level" prefWidth="65" minWidth="45"/>
                      <TableColumn fx:id="heroStatusColumn" text="Status" prefWidth="115" minWidth="45"/>
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                      <Label text="No heroes in the guild." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                    </placeholder>
                  </TableView>
                </VBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0" styleClass="content-scroll" fx:id="heroDetailScroll">
                  <content>
                    <VBox spacing="16" styleClass="panel" minWidth="0" minHeight="0">
                      <HBox spacing="12" alignment="CENTER_LEFT">
                        <ImageView fitWidth="110" fitHeight="115" preserveRatio="true" smooth="false" fx:id="heroPortraitImageView"/>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                          <Label text="—" styleClass="profile-name" fx:id="selectedHeroNameLabel"/>
                          <Label text="—" styleClass="muted" fx:id="selectedHeroClassLabel"/>
                          <Label text="—" styleClass="muted" fx:id="selectedHeroStatusLabel"/>
                        </VBox>
                        <VBox spacing="12" prefWidth="180">
                          <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                            <Label text="Level" styleClass="muted"/>
                            <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                            <Label text="—" styleClass="value" fx:id="selectedHeroLevelLabel"/>
                          </HBox>
                          <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                            <Label text="Wage" styleClass="muted"/>
                            <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                            <Label text="—" styleClass="value" fx:id="selectedHeroWageLabel"/>
                          </HBox>
                        </VBox>
                      </HBox>
                      <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Experience" styleClass="muted"/>
                        <ProgressBar fx:id="heroExperienceProgressBar" progress="0" minHeight="14" prefHeight="14" maxHeight="14" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Label text="—" styleClass="small" fx:id="heroExperienceLabel"/>
                      </HBox>
                      <Separator/>
                      <Label text="EQUIPMENT" styleClass="section-title"/>
                      <HBox spacing="20" alignment="CENTER_LEFT">
                        <VBox spacing="12" prefWidth="280" HBox.hgrow="ALWAYS" minWidth="0">
                          <Label text="OFFENSE" styleClass="section-title"/>
                          <HBox spacing="12" alignment="CENTER_LEFT">
                            <ImageView fitWidth="56" fitHeight="65" preserveRatio="true" smooth="false" fx:id="offenseWeaponImageView"/>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                              <Label text="—" styleClass="item-title" fx:id="offenseWeaponNameLabel"/>
                              <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                <Label text="Power" styleClass="muted"/>
                                <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                <Label text="—" styleClass="value" fx:id="offenseWeaponPowerLabel"/>
                              </HBox>
                            </VBox>
                          </HBox>
                          <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button fx:id="offenseChangeButton" text="Change" mnemonicParsing="false" styleClass="primary" disable="true" maxWidth="Infinity"/>
                            <Button fx:id="offenseUnequipButton" text="Unequip" mnemonicParsing="false" styleClass="secondary" disable="true" maxWidth="Infinity"/>
                          </HBox>
                        </VBox>
                        <VBox spacing="12" prefWidth="280" HBox.hgrow="ALWAYS" minWidth="0">
                          <Label text="DEFENSE" styleClass="section-title"/>
                          <HBox spacing="12" alignment="CENTER_LEFT">
                            <ImageView fitWidth="56" fitHeight="65" preserveRatio="true" smooth="false" fx:id="defenseWeaponImageView"/>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                              <Label text="—" styleClass="item-title" fx:id="defenseWeaponNameLabel"/>
                              <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                                <Label text="Power" styleClass="muted"/>
                                <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                                <Label text="—" styleClass="value" fx:id="defenseWeaponPowerLabel"/>
                              </HBox>
                            </VBox>
                          </HBox>
                          <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button fx:id="defenseChangeButton" text="Change" mnemonicParsing="false" styleClass="primary" disable="true" maxWidth="Infinity"/>
                            <Button fx:id="defenseUnequipButton" text="Unequip" mnemonicParsing="false" styleClass="secondary" disable="true" maxWidth="Infinity"/>
                          </HBox>
                        </VBox>
                      </HBox>
                      <Region VBox.vgrow="ALWAYS" minHeight="0"/>
                      <Label text="Select a hero to view details. Equipment stays with the hero between expeditions." styleClass="small" wrapText="true"/>
                      <Label fx:id="heroFeedbackLabel" text="" styleClass="feedback" wrapText="true" visible="false" managed="false"/>
                    </VBox>
                  </content>
                </ScrollPane>
              </items>
            </SplitPane>
          </content>
        </Tab>
        <Tab fx:id="recruitmentTab" text="Recruitment" closable="false" disable="false">
          <content>
            <SplitPane dividerPositions="0.46" VBox.vgrow="ALWAYS" minHeight="0" styleClass="content-split">
              <items>
                <VBox spacing="12" styleClass="panel" minWidth="0" minHeight="0">
                  <HBox spacing="12" styleClass="heading" alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                      <Label text="Recruitment board" styleClass="page-title"/>
                      <Label text="Applicants refresh with the new day." styleClass="muted" wrapText="true"/>
                    </VBox>
                  </HBox>
                  <TableView fx:id="recruitmentTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                    <columns>
                      <TableColumn fx:id="candidateNameColumn" text="Name" prefWidth="145" minWidth="45"/>
                      <TableColumn fx:id="candidateClassColumn" text="Class" prefWidth="100" minWidth="45"/>
                      <TableColumn fx:id="candidateLevelColumn" text="Level" prefWidth="70" minWidth="45"/>
                      <TableColumn fx:id="candidateFeeColumn" text="Hire fee" prefWidth="95" minWidth="45"/>
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                      <Label text="No candidates available." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                    </placeholder>
                  </TableView>
                </VBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0" styleClass="content-scroll" fx:id="recruitmentDetailScroll">
                  <content>
                    <VBox spacing="8" styleClass="panel" minWidth="0" minHeight="0">
                      <HBox spacing="12" alignment="CENTER_LEFT">
                        <ImageView fitWidth="95" fitHeight="100" preserveRatio="true" smooth="false" fx:id="candidatePortraitImageView"/>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                          <Label text="—" styleClass="profile-name" fx:id="selectedCandidateNameLabel"/>
                          <Label text="—" styleClass="muted" fx:id="selectedCandidateClassLabel"/>
                        </VBox>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Level" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="candidateLevelLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Experience" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="candidateExperienceLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Expedition wage" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="candidateWageLabel"/>
                      </HBox>
                      <Separator/>
                      <Label text="STARTING EQUIPMENT" styleClass="section-title"/>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Offense" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="candidateOffenseWeaponLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Defense" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="candidateDefenseWeaponLabel"/>
                      </HBox>
                      <Separator/>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="One-time hiring fee" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="candidateHiringFeeLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Gold after hiring" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="candidateGoldAfterHiringLabel"/>
                      </HBox>
                      <Label fx:id="recruitmentFeedbackLabel" text="" styleClass="feedback" wrapText="true" visible="false" managed="false"/>
                      <Button fx:id="recruitButton" text="Recruit" mnemonicParsing="false" styleClass="primary" disable="true" maxWidth="Infinity"/>
                      <Label text="Hiring is a one-time cost. Wages are paid for each expedition." styleClass="small" wrapText="true"/>
                    </VBox>
                  </content>
                </ScrollPane>
              </items>
            </SplitPane>
          </content>
        </Tab>
        <Tab fx:id="inventoryTab" text="Inventory" closable="false" disable="false">
          <content>
            <SplitPane dividerPositions="0.57" VBox.vgrow="ALWAYS" minHeight="0" styleClass="content-split">
              <items>
                <VBox spacing="12" styleClass="panel" minWidth="0" minHeight="0">
                  <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Guild inventory" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                    <ComboBox fx:id="inventoryCategoryComboBox" promptText="All items" prefWidth="150" minWidth="130"/>
                  </HBox>
                  <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                    <columns>
                      <TableColumn fx:id="inventoryItemColumn" text="Item" prefWidth="225" minWidth="45"/>
                      <TableColumn fx:id="inventoryQuantityColumn" text="Qty" prefWidth="65" minWidth="45"/>
                      <TableColumn fx:id="inventoryStatusColumn" text="Status" prefWidth="215" minWidth="45"/>
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                      <Label text="The guild inventory is empty." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                    </placeholder>
                  </TableView>
                </VBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0" styleClass="content-scroll" fx:id="inventoryDetailScroll">
                  <content>
                    <VBox spacing="16" styleClass="panel" minWidth="0" minHeight="0">
                      <HBox spacing="12" alignment="CENTER_LEFT">
                        <ImageView fitWidth="95" fitHeight="100" preserveRatio="true" smooth="false" fx:id="inventoryItemImageView"/>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                          <Label text="—" styleClass="detail-title" fx:id="inventoryItemNameLabel"/>
                          <Label text="—" styleClass="muted" fx:id="inventoryItemTypeLabel"/>
                        </VBox>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Power" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="inventoryItemPowerLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Owned" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="inventoryOwnedLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Unassigned" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="inventoryUnassignedLabel"/>
                      </HBox>
                      <Separator/>
                      <Label fx:id="inventoryItemDescriptionLabel" text="Select an item to view its details." styleClass="muted" wrapText="true"/>
                      <Region VBox.vgrow="ALWAYS" minHeight="0"/>
                      <Button fx:id="manageEquipmentButton" text="Manage equipment" mnemonicParsing="false" styleClass="secondary" disable="true" maxWidth="Infinity"/>
                      <Label text="Equip weapons from a hero's profile. Assign supplies when preparing an expedition." styleClass="small" wrapText="true"/>
                    </VBox>
                  </content>
                </ScrollPane>
              </items>
            </SplitPane>
          </content>
        </Tab>
        <Tab fx:id="shopTab" text="Shop" closable="false" disable="false">
          <content>
            <SplitPane dividerPositions="0.56" VBox.vgrow="ALWAYS" minHeight="0" styleClass="content-split">
              <items>
                <VBox spacing="12" styleClass="panel" minWidth="0" minHeight="0">
                  <HBox spacing="12" styleClass="heading" alignment="CENTER_LEFT">
                    <ImageView fitWidth="86" fitHeight="70" preserveRatio="true" smooth="false">
                      <image>
                        <Image url="@assets/merchant.png"/>
                      </image>
                    </ImageView>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                      <Label text="Guild shop" styleClass="page-title"/>
                    </VBox>
                  </HBox>
                  <HBox spacing="12" alignment="CENTER_LEFT">
                    <ToggleButton fx:id="shopBuyToggle" text="Buy" selected="true" toggleGroup="$shopModeToggleGroup" styleClass="mode-toggle" minWidth="110"/>
                    <ToggleButton fx:id="shopSellToggle" text="Sell" toggleGroup="$shopModeToggleGroup" styleClass="mode-toggle" minWidth="110"/>
                    <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                    <ComboBox fx:id="shopCategoryComboBox" promptText="All items" prefWidth="150" minWidth="130"/>
                  </HBox>
                  <TableView fx:id="shopItemsTable" VBox.vgrow="ALWAYS" minHeight="100" styleClass="data-table">
                    <columns>
                      <TableColumn fx:id="shopItemColumn" text="Item" prefWidth="230" minWidth="45"/>
                      <TableColumn fx:id="shopQuantityColumn" text="Stock / owned" prefWidth="105" minWidth="45"/>
                      <TableColumn fx:id="shopPriceColumn" text="Unit price" prefWidth="105" minWidth="45"/>
                    </columns>
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                    </columnResizePolicy>
                    <placeholder>
                      <Label text="No items available in this mode." styleClass="empty-text" wrapText="true" textAlignment="CENTER"/>
                    </placeholder>
                  </TableView>
                  <Label text="Shop stock refreshes with the new day." styleClass="small"/>
                </VBox>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="0" styleClass="content-scroll" fx:id="shopDetailScroll">
                  <content>
                    <VBox spacing="14" styleClass="panel" minWidth="0" minHeight="0">
                      <HBox spacing="12" alignment="CENTER_LEFT">
                        <ImageView fitWidth="90" fitHeight="100" preserveRatio="true" smooth="false" fx:id="shopItemImageView"/>
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                          <Label text="—" styleClass="detail-title" fx:id="shopItemNameLabel"/>
                          <Label text="—" styleClass="muted" fx:id="shopItemTypeLabel"/>
                        </VBox>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Power" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="shopItemPowerLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Unit value" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="shopUnitPriceLabel"/>
                      </HBox>
                      <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Quantity" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Spinner fx:id="shopQuantitySpinner" editable="false" disable="true" prefWidth="110"/>
                      </HBox>
                      <Separator/>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Total" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="shopTotalLabel"/>
                      </HBox>
                      <HBox spacing="12" styleClass="stat-row" alignment="CENTER_LEFT">
                        <Label text="Gold after transaction" styleClass="muted"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="0"/>
                        <Label text="—" styleClass="value" fx:id="shopGoldAfterTransactionLabel"/>
                      </HBox>
                      <Label fx:id="shopFeedbackLabel" text="" styleClass="feedback" wrapText="true" visible="false" managed="false"/>
                      <Region VBox.vgrow="ALWAYS" minHeight="0"/>
                      <Button fx:id="shopTransactionButton" text="Buy" mnemonicParsing="false" styleClass="primary" disable="true" maxWidth="Infinity"/>
                      <Label text="Purchases require enough gold. Only unassigned equipment can be sold." styleClass="small" wrapText="true"/>
                    </VBox>
                  </content>
                </ScrollPane>
              </items>
            </SplitPane>
          </content>
        </Tab>
      </tabs>
    </TabPane>
  </center>
  <bottom>
    <HBox spacing="12" styleClass="app-footer" alignment="CENTER_LEFT">
      <ImageView fitWidth="25" fitHeight="30" preserveRatio="true" smooth="false">
        <image>
          <Image url="@assets/leaf.png"/>
        </image>
      </ImageView>
      <Label fx:id="statusLabel" text="" styleClass="muted" wrapText="true" HBox.hgrow="ALWAYS"/>
      <Region HBox.hgrow="ALWAYS" minWidth="0"/>
      <Button fx:id="endDayButton" text="End day" mnemonicParsing="false" styleClass="primary" disable="false" maxWidth="Infinity"/>
    </HBox>
  </bottom>
</BorderPane>
