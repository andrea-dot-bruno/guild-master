<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="360.0" styleClass="game-menu" stylesheets="@guild-theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg130419.controller.GameMenuController">
   <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="game-menu-header">
      <ImageView fitHeight="38.0" fitWidth="32.0" preserveRatio="true">
         <image>
            <Image url="@../assets/crest.png" />
         </image>
      </ImageView>
      <Label styleClass="game-menu-title" text="Game Menu" />
   </HBox>
   <VBox spacing="8.0" styleClass="game-menu-actions">
      <Label styleClass="game-menu-status" text="Saving is not available yet." wrapText="true" />
      <Button disable="true" maxWidth="Infinity" mnemonicParsing="false" styleClass="button-main" text="Save Game" />
      <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleQuitGameButton" styleClass="button-secondary" text="Quit Game" />
      <Button fx:id="closeMenuButton" cancelButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCloseMenuButton" styleClass="button-secondary" text="Close Menu">
         <VBox.margin>
            <Insets top="12.0" />
         </VBox.margin>
      </Button>
   </VBox>
</VBox>
