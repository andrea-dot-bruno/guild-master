<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="530.0" prefWidth="1100.0" stylesheets="@guild-theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg130419.controller.OverviewController">
   <children>
      <HBox alignment="CENTER" prefHeight="61.0" prefWidth="1100.0" spacing="10.0">
         <children>
            <ImageView fitHeight="64.0" fitWidth="98.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../assets/guild-house.png" />
               </image>
            </ImageView>
            <VBox prefHeight="100.0" prefWidth="389.0">
               <children>
                  <Label text="A new day at the guild" styleClass="screen-title" />
                  <Label prefWidth="395.0" text="Prepare your heroes, then coose your next expedition." textFill="#0000009d" />
               </children>
            </VBox>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="planExpeditionButton" alignment="CENTER" mnemonicParsing="false" onAction="#handlePlanExpeditionButton" prefHeight="42.0" prefWidth="163.0" styleClass="button-main, plan-expedition-button" text="Plan Expedition" textAlignment="CENTER" />
         </children>
         <VBox.margin>
            <Insets left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox prefHeight="430.0" prefWidth="834.0">
               <children>
                  <Label text="ACTIVE EXPEDITIONS" styleClass="section-title">
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </Label>
                  <TableView fx:id="activeExpeditionsTable" prefHeight="403.0" prefWidth="769.0">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="aeTableExpeditionColumn" prefWidth="235.0" text="Expedition" />
                        <TableColumn fx:id="aeTableHeroesColumn" prefWidth="280.0" text="Heroes" />
                        <TableColumn fx:id="aeTableRemainingColumn" prefWidth="100.0" styleClass="numeric-column" text="Remaining" />
                        <TableColumn fx:id="aeTableGoldRewardColumn" prefWidth="105.0" styleClass="numeric-column" text="Gold Reward" />
                        <TableColumn fx:id="aeTableSuccessChanceColumn" minWidth="110.0" prefWidth="114.0" styleClass="numeric-column" text="Success Chance" />
                     </columns>
                  </TableView>
               </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </VBox>
            <VBox layoutX="10.0" layoutY="10.0" prefHeight="430.0" prefWidth="255.0">
               <children>
                  <Label text="AVAILABLE HEROES" styleClass="section-title">
                     <VBox.margin>
                        <Insets bottom="5.0" />
                     </VBox.margin>
                  </Label>
                  <ListView fx:id="availableHeroesList" prefHeight="363.0" prefWidth="256.0" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </ListView>
                  <Button fx:id="viewHeroesButton" mnemonicParsing="false" onAction="#handleViewHeroesButton" prefHeight="51.0" prefWidth="255.0" styleClass="button-secondary, view-heroes-button" text="View Heroes" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets top="15.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
