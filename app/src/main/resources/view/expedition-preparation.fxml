<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="720.0" styleClass="expedition-preparation" stylesheets="@guild-theme.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg130419.controller.ExpeditionPreparationController">
   <Label alignment="CENTER" maxWidth="Infinity" styleClass="preparation-title" text="Preparing Expedition" />
   <HBox spacing="20.0" styleClass="preparation-content">
      <VBox prefWidth="330.0" spacing="12.0" styleClass="preparation-dungeon" HBox.hgrow="ALWAYS">
         <VBox alignment="CENTER" spacing="8.0">
            <Label fx:id="dungeonName" styleClass="preparation-section-title" textAlignment="CENTER" wrapText="true" />
            <ImageView fx:id="dungeonIcon" fitHeight="144.0" fitWidth="216.0" preserveRatio="true" />
         </VBox>
         <VBox spacing="6.0" styleClass="preparation-dungeon-stats">
            <Label fx:id="dungeonDifficulty" />
            <Label fx:id="dungeonGoldReward" />
            <Label fx:id="dungeonExpReward" />
         </VBox>
         <Separator />
         <VBox spacing="8.0">
            <Label styleClass="preparation-section-title" text="Probability of Success" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <ProgressBar fx:id="probabilityBar" accessibleText="Probability of Success" maxWidth="Infinity"
                            progress="0.0" HBox.hgrow="ALWAYS" />
               <Label fx:id="probabilityLabel" alignment="CENTER_RIGHT" minWidth="64.0"
                      styleClass="preparation-probability-value" text="0%" />
            </HBox>
         </VBox>
      </VBox>
      <VBox prefWidth="300.0" spacing="8.0" styleClass="preparation-party">
         <Label styleClass="preparation-section-title" text="Available Heroes" />
         <ScrollPane accessibleText="Available Heroes" fitToWidth="true" hbarPolicy="NEVER" prefViewportHeight="290.0"
                     styleClass="preparation-hero-scroll" VBox.vgrow="ALWAYS">
            <content>
               <VBox fx:id="heroCards" spacing="6.0" styleClass="preparation-hero-cards" />
            </content>
         </ScrollPane>
      </VBox>
   </HBox>
   <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="preparation-actions">
      <Label fx:id="launchError" maxWidth="Infinity" styleClass="preparation-error"
             text="The expedition could not be launched." visible="false" wrapText="true" HBox.hgrow="ALWAYS" />
      <Button cancelButton="true" mnemonicParsing="false" onAction="#handleCancel"
              styleClass="button-secondary" text="Cancel" />
      <Button fx:id="launchButton" disable="true" mnemonicParsing="false" onAction="#handleLaunch"
              styleClass="button-main" text="Launch Expedition" />
   </HBox>
</VBox>
