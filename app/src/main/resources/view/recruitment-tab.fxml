<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="1100.0" stylesheets="@guild-theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg130419.controller.RecruitmentController">
   <children>
      <Label prefHeight="22.0" prefWidth="336.0" text="Recruitment Board">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Label>
      <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="recruitmentCandidatesTable" prefHeight="457.0" prefWidth="478.0">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="candidateNameColumn" prefWidth="166.45214653015137" text="Name" />
                  <TableColumn fx:id="candidateClassColumn" prefWidth="92.56797790527344" text="Class" />
                  <TableColumn fx:id="candidateLevelColumn" prefWidth="66.93203735351562" styleClass="numeric-column" text="Level" />
                  <TableColumn fx:id="candidatePayColumn" prefWidth="71.112060546875" styleClass="numeric-column" text="Pay" />
                  <TableColumn fx:id="candidateHireFeeColumn" prefWidth="81.38790893554688" styleClass="numeric-column" text="Hire Fee" />
               </columns>
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </TableView>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="dungeon-details" HBox.hgrow="ALWAYS">
               <children>
                  <HBox prefHeight="0.0" prefWidth="603.0">
                     <children>
                        <ImageView fx:id="recruitHeroIcon" fitHeight="73.0" fitWidth="123.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/mage-icons/lyra.png" />
                           </image>
                        </ImageView>
                        <Label fx:id="recruitHeroName" prefHeight="66.0" prefWidth="390.0" text="&lt;player-name&gt;" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Label fx:id="recruitHeroLevel" layoutX="21.0" layoutY="10.0" prefHeight="0.0" prefWidth="603.0" text="&lt;level&gt;" textAlignment="CENTER">
                     <font>
                        <Font size="19.0" />
                     </font>
                  </Label>
                  <Label fx:id="recruitHeroClass" layoutX="21.0" layoutY="42.0" prefHeight="0.0" prefWidth="603.0" text="&lt;class&gt;" textAlignment="CENTER">
                     <font>
                        <Font size="19.0" />
                     </font>
                  </Label>
                  <Label fx:id="recruitHeroPay" layoutX="21.0" layoutY="133.0" prefHeight="0.0" prefWidth="603.0" text="&lt;pay&gt;" textAlignment="CENTER">
                     <font>
                        <Font size="19.0" />
                     </font>
                  </Label>
                  <Label fx:id="recruitHeroHireFee" layoutX="21.0" layoutY="129.0" prefHeight="0.0" prefWidth="603.0" text="&lt;hire-fee&gt;" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <BorderPane prefHeight="200.0" prefWidth="200.0" styleClass="equipment-border-pane">
                     <top>
                        <Label text="EQUIPMENT" BorderPane.alignment="CENTER">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </top>
                     <left>
                        <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="170.0" BorderPane.alignment="CENTER">
                           <children>
                              <ImageView fx:id="recruitHeroLeftItemIcon" fitHeight="130.0" fitWidth="143.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../assets/weapon-icons/iron-sword.png" />
                                 </image>
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </ImageView>
                              <Label fx:id="recruitHeroLeftItemDamage" text="&lt;weapon-damage&gt;">
                                 <font>
                                    <Font size="19.0" />
                                 </font>
                              </Label>
                           </children>
                           <BorderPane.margin>
                              <Insets left="100.0" />
                           </BorderPane.margin>
                        </VBox>
                     </left>
                     <right>
                        <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="170.0" BorderPane.alignment="CENTER">
                           <children>
                              <ImageView fx:id="recruitHeroRightItemIcon" fitHeight="130.0" fitWidth="119.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../assets/weapon-icons/shield.png" />
                                 </image>
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </ImageView>
                              <Label fx:id="recruitHeroRightItemDamage" prefHeight="23.0" prefWidth="221.0" text="&lt;weapon-damage&gt;">
                                 <font>
                                    <Font size="19.0" />
                                 </font>
                              </Label>
                           </children>
                           <BorderPane.margin>
                              <Insets right="100.0" />
                           </BorderPane.margin>
                        </VBox>
                     </right>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </BorderPane>
                  <Button fx:id="hireHeroButton" alignment="CENTER" mnemonicParsing="false" onAction="#handleHireHeroButton" prefHeight="67.0" prefWidth="177.0" styleClass="button-main" text="Hire Hero" textAlignment="CENTER" wrapText="true">
                     <VBox.margin>
                        <Insets top="7.0" />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
