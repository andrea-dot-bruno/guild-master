<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="660.0" styleClass="game-menu" stylesheets="@guild-theme.css"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.unicam.cs.mpgc.rpg130419.controller.dialogs.GuildIntroductionController">
   <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="game-menu-header">
      <ImageView fitHeight="38.0" fitWidth="32.0" preserveRatio="true">
         <image>
            <Image url="@../assets/crest.png" />
         </image>
      </ImageView>
      <Label styleClass="game-menu-title" text="Welcome Back, Captain" />
   </HBox>
   <VBox spacing="13.0" styleClass="introduction-content">
      <Label wrapText="true"
             text="Welcome back to the Guild, Captain! Thank goodness you’re back. Just a few days away, and things have been piling up around here!" />
      <Label wrapText="true"
             text="While you were gone, that stubborn Bram set off for Mossroot Warren on his own. He wouldn’t hear of anyone going with him. Lyra, meanwhile, is sitting on her floating stump reading her books, as usual. On top of that, the little gold you set aside is nearly gone. Let’s hope Bram brings back something worth selling, at least enough to keep us from going bankrupt." />
      <Label wrapText="true"
             text="Oh, and somehow there are a couple of youngsters who want to join the Guild. I wonder what they see in this place, but I suppose they have their reasons…" />
      <Label wrapText="true"
             text="I think it’s about time we gave our Guild a name, don’t you? We need something to put on the invoices. …You have been sending those out, right?" />
      <VBox spacing="5.0">
         <Label styleClass="introduction-field-label" text="Guild Name" />
         <TextField fx:id="guildNameField" accessibleText="Guild Name" />
      </VBox>
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <Label fx:id="saveError" maxWidth="Infinity" styleClass="introduction-error"
                text="Could not save the new game. Please try again." visible="false" HBox.hgrow="ALWAYS" />
         <Button fx:id="confirmButton" defaultButton="true" mnemonicParsing="false" onAction="#handleConfirm"
                 styleClass="button-main" text="Confirm" />
      </HBox>
   </VBox>
</VBox>
