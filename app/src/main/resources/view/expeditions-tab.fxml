<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="530.0" prefWidth="1100.0" stylesheets="@guild-theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg130419.controller.tabs.ExpeditionsController">
   <children>
      <Label prefHeight="22.0" prefWidth="336.0" text="Expedition Board" styleClass="screen-title" />
      <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="availableDungeonsTable" prefHeight="457.0" prefWidth="635.0">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="dungeonNameColumn" prefWidth="378.4744510650635" text="Dungeon" />
                  <TableColumn fx:id="dungeonDaysColumn" prefWidth="119.52549743652344" styleClass="numeric-column" text="Days" />
                  <TableColumn fx:id="dungeonGoldRewardColumn" prefWidth="136.7202911376953" styleClass="numeric-column" text="Gold Reward" />
                  <TableColumn fx:id="dungeonDifficultyColumn" prefWidth="136.7202911376953" styleClass="numeric-column" text="Difficulty" />
               </columns>
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </TableView>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="dungeon-details" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="boardDungeonName" alignment="CENTER" prefHeight="82.0" prefWidth="424.0" styleClass="detail-title" text="&lt;dungeon-name&gt;" textAlignment="CENTER" wrapText="true" />
                  <ImageView fx:id="boardDungeonIcon" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../assets/dungeon-icons/emberstone.png" />
                     </image>
                  </ImageView>
                  <HBox alignment="CENTER" spacing="24.0">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                     <children>
                        <Label fx:id="boardDungeonDifficulty" styleClass="detail-stat" text="Difficulty: 8" />
                        <Label fx:id="boardDungeonDays" styleClass="detail-stat" text="Days: 1" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" spacing="24.0">
                     <VBox.margin>
                        <Insets top="6.0" />
                     </VBox.margin>
                     <children>
                        <Label fx:id="boardDungeonGoldReward" styleClass="detail-stat, detail-stat-primary" text="Gold Reward: 100 G" />
                        <Label fx:id="boardDungeonExpReward" styleClass="detail-stat, detail-stat-primary" text="XP Reward: 50" />
                     </children>
                  </HBox>
                  <Button fx:id="prepareExpeditionButton" alignment="CENTER" mnemonicParsing="false" onAction="#handlePrepareExpeditionButton" prefHeight="67.0" prefWidth="177.0" styleClass="button-main, board-action" text="Prepare Expedition" textAlignment="CENTER" wrapText="true">
                     <VBox.margin>
                        <Insets top="40.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets left="10.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
