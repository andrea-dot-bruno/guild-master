<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="530.0" prefWidth="1100.0" stylesheets="@guild-theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg130419.controller.HeroesController">
   <children>
      <Label prefHeight="22.0" prefWidth="336.0" text="Guild Heroes">
         <font>
            <Font name="System Bold" size="33.0" />
         </font>
      </Label>
      <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="guildHeroesTable" prefHeight="457.0" prefWidth="456.0">
               <columns>
                  <TableColumn prefWidth="132.85873985290527" text="Name" />
                  <TableColumn prefWidth="99.14127349853516" text="Class" />
                  <TableColumn prefWidth="67.26530456542969" text="Level" />
                  <TableColumn prefWidth="61.267791748046875" text="Pay" />
                  <TableColumn prefWidth="95.732177734375" text="Status" />
               </columns>
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </TableView>
            <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" styleClass="dungeon-details" HBox.hgrow="ALWAYS">
               <children>
                  <HBox prefHeight="0.0" prefWidth="603.0">
                     <children>
                        <ImageView fx:id="guildHeroIcon" fitHeight="73.0" fitWidth="123.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/knight-icons/cedric.png" />
                           </image>
                        </ImageView>
                        <Label fx:id="guildHeroName" prefHeight="66.0" prefWidth="390.0" text="&lt;player-name&gt;" textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font name="System Bold" size="28.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <Label fx:id="guildHeroLevel" layoutX="21.0" layoutY="10.0" prefHeight="0.0" prefWidth="603.0" text="&lt;level&gt;" textAlignment="CENTER">
                     <font>
                        <Font size="19.0" />
                     </font>
                  </Label>
                  <Label fx:id="guildHeroClass" layoutX="21.0" layoutY="42.0" prefHeight="0.0" prefWidth="603.0" text="&lt;class&gt;" textAlignment="CENTER">
                     <font>
                        <Font size="19.0" />
                     </font>
                  </Label>
                  <Label fx:id="guildHeroPay" layoutX="21.0" layoutY="133.0" prefHeight="0.0" prefWidth="603.0" text="&lt;pay&gt;" textAlignment="CENTER">
                     <font>
                        <Font size="19.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_LEFT" prefHeight="0.0" prefWidth="593.0">
                     <children>
                        <Label prefHeight="23.0" prefWidth="105.0" text="Experience:" textAlignment="CENTER">
                           <font>
                              <Font size="19.0" />
                           </font>
                        </Label>
                        <ProgressBar fx:id="guildHeroExpBar" prefHeight="23.0" prefWidth="489.0" progress="0.0" />
                     </children>
                  </HBox>
                  <BorderPane prefHeight="200.0" prefWidth="200.0" styleClass="equipment-border-pane">
                     <top>
                        <Label text="EQUIPMENT" BorderPane.alignment="CENTER">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                     </top>
                     <left>
                        <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="170.0" BorderPane.alignment="CENTER">
                           <children>
                              <ImageView fx:id="guildHeroLeftWeaponIcon" fitHeight="130.0" fitWidth="143.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../assets/weapon-icons/iron-sword.png" />
                                 </image>
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </ImageView>
                              <Label fx:id="guildHeroLeftWeaponDamage" text="&lt;weapon-damage&gt;">
                                 <font>
                                    <Font size="19.0" />
                                 </font>
                              </Label>
                           </children>
                           <BorderPane.margin>
                              <Insets left="100.0" />
                           </BorderPane.margin>
                        </VBox>
                     </left>
                     <right>
                        <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="170.0" BorderPane.alignment="CENTER">
                           <children>
                              <ImageView fx:id="guildHeroRightWeaponIcon" fitHeight="130.0" fitWidth="119.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../assets/weapon-icons/shield.png" />
                                 </image>
                                 <VBox.margin>
                                    <Insets />
                                 </VBox.margin>
                              </ImageView>
                              <Label fx:id="guildHeroRightWeaponDamage" prefHeight="23.0" prefWidth="221.0" text="&lt;weapon-damage&gt;">
                                 <font>
                                    <Font size="19.0" />
                                 </font>
                              </Label>
                           </children>
                           <BorderPane.margin>
                              <Insets right="100.0" />
                           </BorderPane.margin>
                        </VBox>
                     </right>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </BorderPane>
                  <Button fx:id="fireHeroButton" alignment="CENTER" mnemonicParsing="false" onAction="#handleFireHeroButton" prefHeight="67.0" prefWidth="177.0" styleClass="button-main" text="Fire Hero" textAlignment="CENTER" wrapText="true">
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Button>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
